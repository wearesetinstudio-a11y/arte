---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  label?: string;
  title?: string;
  items?: FaqItem[];
}

const {
  label = "FAQ",
  title = "Pytania na które znajdziesz odpowiedź",
  items = [
    {
      question: "Jak wygląda pierwsza lekcja?",
      answer:
        "Zaczynamy od krótkiej rozmowy o Twoich celach i doświadczeniu, potem pracujemy nad podstawami techniki i świadomości ciała — w tempie dopasowanym do Ciebie.",
    },
    {
      question: "Czy muszę mieć doświadczenie taneczne?",
      answer:
        "Nie. Przyjmujemy zarówno osoby początkujące, jak i zaawansowane. Program budujemy wokół Twojego poziomu i realnych potrzeb.",
    },
    {
      question: "Jakie style tańca oferujecie?",
      answer:
        "Broadway Jazz, Jazz, High Heels, Performance oraz trening personalny. Każdą grupę i współpracę formujemy indywidualnie.",
    },
    {
      question: "Jak zapisać się na zajęcia?",
      answer:
        "Napisz do nas przez formularz kontaktowy lub wiadomość prywatną. Opisz cele i doświadczenie — odezwiemy się z propozycją terminu.",
    },
    {
      question: "Gdzie znajduje się studio?",
      answer:
        "Prowadzimy zajęcia w Poznaniu. Dokładną lokalizację i dojazd podajemy przy umawianiu pierwszej lekcji.",
    },
  ],
} = Astro.props;
---

<section class="dance-faq" id="faq" data-faq aria-labelledby="faq-heading">
  <div class="dance-faq__inner">
    <header class="dance-faq__header">
      <p class="dance-faq__label">{label}</p>
      <h2 id="faq-heading" class="dance-faq__title">{title}</h2>
    </header>

    <ul class="dance-faq__list">
      {
        items.map((item, index) => {
          const n = String(index + 1).padStart(2, "0");
          const open = index === 0;
          const panelId = `faq-panel-${index + 1}`;
          const triggerId = `faq-trigger-${index + 1}`;

          return (
            <li class:list={["dance-faq__item", open && "is-open"]} data-faq-item>
              <button
                type="button"
                class="dance-faq__trigger"
                id={triggerId}
                data-faq-trigger
                aria-expanded={open ? "true" : "false"}
                aria-controls={panelId}
              >
                <span class="dance-faq__index" aria-hidden="true">
                  {n}
                </span>
                <span class="dance-faq__question">{item.question}</span>
                <span class="dance-faq__icon" aria-hidden="true">
                  <img src="/arrow.svg" alt="" width="26" height="26" />
                </span>
              </button>

              <div
                class="dance-faq__panel"
                id={panelId}
                role="region"
                aria-labelledby={triggerId}
                data-faq-panel
                aria-hidden={open ? "false" : "true"}
                {...(open ? {} : { inert: true })}
              >
                <p class="dance-faq__answer">{item.answer}</p>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .dance-faq {
    --faq-rail: 2.75rem;
    --faq-gap: clamp(1.25rem, 3vw, 2.75rem);
    --faq-pad-x: clamp(1.5rem, 4vw, 3.25rem);

    background: #ffffff;
    color: #1e1e1e;
    padding: clamp(7rem, 18vh, 11rem) var(--faq-pad-x);
    scroll-margin-top: 1.5rem;
  }

  @media (min-width: 721px) {
    .dance-faq {
      --faq-pad-x: clamp(2.5rem, 12vw, 10rem);
    }
  }

  .dance-faq__inner {
    width: min(100%, 78rem);
    margin-inline: auto;
  }

  .dance-faq__header {
    display: grid;
    grid-template-columns: var(--faq-rail) minmax(0, 1fr);
    gap: var(--faq-gap);
    align-items: baseline;
    margin-bottom: clamp(3.25rem, 8vh, 5.5rem);
  }

  .dance-faq__label,
  .dance-faq__title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    line-height: 1.4;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .dance-faq__label {
    color: var(--color-muted);
  }

  .dance-faq__title {
    min-width: 0;
  }

  .dance-faq__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .dance-faq__item {
    display: grid;
    gap: 0;
    padding-block: clamp(1.85rem, 4.5vh, 2.75rem);
    border-top: 1px solid rgb(30 30 30 / 0.12);
    cursor: pointer;
  }

  .dance-faq__item:first-child {
    border-top: 0;
    padding-top: 0.35rem;
  }

  .dance-faq__item:last-child {
    padding-bottom: 0.35rem;
  }

  .dance-faq__trigger {
    display: grid;
    grid-template-columns: var(--faq-rail) minmax(0, 1fr) auto;
    gap: var(--faq-gap);
    align-items: center;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .dance-faq__trigger:focus-visible {
    outline: 1px solid #1e1e1e;
    outline-offset: 6px;
  }

  .dance-faq__index {
    padding-top: 0.2em;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.3;
    color: var(--color-muted);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .dance-faq__question {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 0.95rem + 0.7vw, 1.55rem);
    font-weight: 500;
    letter-spacing: -0.028em;
    line-height: 1.25;
    white-space: nowrap;
    transition: opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .dance-faq__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .dance-faq__icon img {
    width: var(--size-arrow);
    height: var(--size-arrow);
    transform: rotate(135deg);
    transform-origin: center;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .dance-faq__item.is-open .dance-faq__icon img {
    transform: rotate(-45deg);
  }

  .dance-faq__item:has(.dance-faq__trigger:focus-visible) .dance-faq__index {
    transform: translateX(10px);
  }

  .dance-faq__item:has(.dance-faq__trigger:focus-visible) .dance-faq__question {
    opacity: 0.6;
  }

  .dance-faq__item:has(.dance-faq__trigger:focus-visible) .dance-faq__icon img {
    transform: translateX(-10px) rotate(135deg);
  }

  .dance-faq__item.is-open:has(.dance-faq__trigger:focus-visible)
    .dance-faq__icon
    img {
    transform: translateX(-10px) rotate(-45deg);
  }

  @media (hover: hover) and (pointer: fine) {
    .dance-faq__item:hover .dance-faq__index {
      transform: translateX(10px);
    }

    .dance-faq__item:hover .dance-faq__question {
      opacity: 0.6;
    }

    .dance-faq__item:hover .dance-faq__icon img {
      transform: translateX(-10px) rotate(135deg);
    }

    .dance-faq__item.is-open:hover .dance-faq__icon img {
      transform: translateX(-10px) rotate(-45deg);
    }
  }

  .dance-faq__panel {
    display: grid;
    grid-template-rows: 0fr;
    padding-left: calc(var(--faq-rail) + var(--faq-gap));
    padding-right: calc(1.25rem + clamp(0.5rem, 1vw, 1rem));
    overflow: hidden;
    opacity: 0;
    transition:
      grid-template-rows 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease;
  }

  .dance-faq__item.is-open .dance-faq__panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .dance-faq__answer {
    margin: 0.7rem 0 0;
    min-height: 0;
    overflow: hidden;
    max-width: 38rem;
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 400;
    line-height: 1.45;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  @media (max-width: 720px) {
    .dance-faq {
      --faq-rail: 1.75rem;
      --faq-gap: 0.85rem;
      padding-block: clamp(5rem, 12vh, 7.5rem);
    }

    .dance-faq__header {
      grid-template-columns: 1fr;
      gap: 0.55rem;
      margin-bottom: 1.75rem;
    }

    .dance-faq__item {
      padding-block: 1.15rem;
    }

    .dance-faq__item:first-child {
      padding-top: 0.15rem;
    }

    .dance-faq__item:last-child {
      padding-bottom: 0.15rem;
    }

    .dance-faq__label,
    .dance-faq__title {
      letter-spacing: 0.06em;
      white-space: normal;
    }

    .dance-faq__question {
      font-size: clamp(1.05rem, 4.2vw, 1.25rem);
      white-space: normal;
    }

    .dance-faq__icon img {
      width: 0.7rem;
      height: 0.7rem;
    }

    .dance-faq__answer {
      margin-top: 0.5rem;
    }

    .dance-faq__panel {
      padding-right: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dance-faq__icon img,
    .dance-faq__panel {
      transition: none;
    }
  }
</style>

<script>
  function initFaq(root: HTMLElement) {
    const items = [...root.querySelectorAll<HTMLElement>("[data-faq-item]")];

    const setOpen = (target: HTMLElement | null) => {
      items.forEach((other) => {
        const otherTrigger = other.querySelector<HTMLButtonElement>(
          "[data-faq-trigger]",
        );
        const otherPanel = other.querySelector<HTMLElement>("[data-faq-panel]");
        if (!otherTrigger || !otherPanel) return;

        const open = other === target;
        other.classList.toggle("is-open", open);
        otherTrigger.setAttribute("aria-expanded", open ? "true" : "false");
        otherPanel.setAttribute("aria-hidden", open ? "false" : "true");
        if (open) otherPanel.removeAttribute("inert");
        else otherPanel.setAttribute("inert", "");
      });
    };

    items.forEach((item) => {
      item.addEventListener("click", () => {
        setOpen(item.classList.contains("is-open") ? null : item);
      });
    });
  }

  function boot() {
    document.querySelectorAll<HTMLElement>("[data-faq]").forEach(initFaq);
  }

  boot();
  document.addEventListener("astro:page-load", boot);
</script>
