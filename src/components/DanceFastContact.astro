---
interface Props {
  instagram?: string;
  whatsappHref?: string;
  messengerHref?: string;
  heroSelector?: string;
  contactSelector?: string;
}

const {
  instagram = "artedebaile_pz",
  whatsappHref = "https://wa.me/48606797737",
  messengerHref = "https://m.me/artedebaile",
  heroSelector = ".dance-hero",
  contactSelector = "#kontakt",
} = Astro.props;

const socials = [
  {
    label: "Instagram",
    href: `https://instagram.com/${instagram}`,
    icon: "/ig.svg",
  },
  {
    label: "WhatsApp",
    href: whatsappHref,
    icon: "/whatsapp.svg",
  },
  {
    label: "Messenger",
    href: messengerHref,
    icon: "/messa.svg",
  },
];
---

<nav
  class="fast-contact"
  data-fast-contact
  data-hero={heroSelector}
  data-contact={contactSelector}
  aria-label="Szybki kontakt"
  aria-hidden="true"
>
  <a href="#kontakt" class="fast-contact__cta" data-fast-cta>
    <span>Umów się</span>
    <img src="/arrow.svg" alt="" width="26" height="26" />
  </a>

  <ul class="fast-contact__socials">
    {
      socials.map((item) => (
        <li>
          <a
            href={item.href}
            class="fast-contact__icon"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={item.label}
          >
            <img src={item.icon} alt="" width="45" height="45" />
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .fast-contact {
    --fast-pad: 0.5rem;
    --fast-gap: 0.5rem;
    --fast-size: 3.25rem;

    position: fixed;
    bottom: 10px;
    left: 50%;
    z-index: 200;
    display: flex;
    align-items: stretch;
    gap: var(--fast-gap);
    width: max-content;
    max-width: calc(100vw - 1.25rem);
    padding: var(--fast-pad);
    background: #111111;
    color: #ffffff;
    transform: translateX(-50%) translateY(calc(100% + 10px));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.35s ease,
      visibility 0.35s ease;
  }

  .fast-contact.is-visible {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .fast-contact__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    min-height: var(--fast-size);
    padding: 0 1rem 0 1.1rem;
    background: #ffffff;
    color: #1e1e1e;
    font-family: var(--font-mono);
    font-size: var(--text-button);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    white-space: nowrap;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .fast-contact__cta img {
    width: var(--size-arrow);
    height: auto;
    flex-shrink: 0;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .fast-contact__cta:hover img,
  .fast-contact__cta:focus-visible img {
    transform: rotate(45deg);
  }

  .fast-contact__cta:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  .fast-contact__socials {
    display: flex;
    align-items: stretch;
    gap: var(--fast-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fast-contact__icon {
    display: grid;
    place-items: center;
    width: var(--fast-size);
    height: var(--fast-size);
    background: #2a2a2a;
    transition: background 0.25s ease;
  }

  .fast-contact__icon img {
    width: 2.15rem;
    height: 2.15rem;
  }

  .fast-contact__icon:hover,
  .fast-contact__icon:focus-visible {
    background: #3a3a3a;
  }

  .fast-contact__icon:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  @media (max-width: 480px) {
    .fast-contact {
      --fast-pad: 0.4rem;
      --fast-gap: 0.4rem;
      --fast-size: 2.85rem;
    }

    .fast-contact__cta {
      padding-inline: 0.85rem 0.75rem;
      gap: 0.55rem;
      font-size: 0.68rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fast-contact {
      transition: opacity 0.2s ease, visibility 0.2s ease;
    }

    .fast-contact.is-visible {
      transform: translateX(-50%) translateY(0);
    }

    .fast-contact__cta img {
      transition: none;
    }
  }
</style>

<script>
  function initFastContact() {
    const bar = document.querySelector<HTMLElement>("[data-fast-contact]");
    if (!bar) return;

    const heroSelector = bar.dataset.hero || ".dance-hero";
    const contactSelector = bar.dataset.contact || "#kontakt";
    const hero = document.querySelector<HTMLElement>(heroSelector);
    const contact = document.querySelector<HTMLElement>(contactSelector);
    if (!hero || !contact) return;

    const cta = bar.querySelector<HTMLAnchorElement>("[data-fast-cta]");
    let visible = false;
    let ticking = false;

    const setVisible = (next: boolean) => {
      if (visible === next) return;
      visible = next;
      bar.classList.toggle("is-visible", next);
      bar.setAttribute("aria-hidden", next ? "false" : "true");
    };

    const update = () => {
      ticking = false;
      const heroBottom = hero.getBoundingClientRect().bottom;
      const contactTop = contact.getBoundingClientRect().top;
      const pastHero = heroBottom <= 0;
      const atContact = contactTop <= window.innerHeight - 10;
      setVisible(pastHero && !atContact);
    };

    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    cta?.addEventListener("click", (event) => {
      const target = document.querySelector<HTMLElement>("#kontakt");
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);
    update();
  }

  initFastContact();
  document.addEventListener("astro:page-load", initFastContact);
</script>
