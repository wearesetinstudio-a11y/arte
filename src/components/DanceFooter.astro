---
const nav = [
  { href: "/jezyki", label: "Języki" },
  { href: "/", label: "Taniec" },
];

const phone = "+48 606 797 737";
const phoneHref = "tel:+48606797737";
const email = "artedebaile@gmail.com";
const whatsappHref = "https://wa.me/48606797737";

const contacts = [
  { label: "Whatsapp", value: phone, href: whatsappHref },
  { label: "E-mail", value: email, href: `mailto:${email}` },
  { label: "Numer telefonu", value: phone, href: phoneHref },
];
---

<footer class="dance-footer">
  <div class="dance-footer__inner">
    <div class="dance-footer__brand">
      <a href="/" class="dance-footer__logo" aria-label="Arte — strona główna">
        <img
          src="/arte-logo-white.svg"
          alt="Arte"
          width="658"
          height="376"
        />
      </a>

      <nav class="dance-footer__nav" aria-label="Stopka">
        {
          nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
      </nav>
    </div>

    <ul class="dance-footer__contacts">
      {
        contacts.map((item) => (
          <li class="dance-footer__contact">
            <span class="dance-footer__contact-label">{item.label}</span>
            <a class="dance-footer__contact-value" href={item.href}>
              {item.value}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .dance-footer {
    background: #171717;
    color: #ffffff;
    padding: clamp(1.75rem, 4vh, 2.75rem) clamp(1.5rem, 4vw, 3.25rem);
  }

  .dance-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3rem);
    width: min(100%, 78rem);
    margin-inline: auto;
  }

  .dance-footer__brand {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.75rem);
    min-width: 0;
  }

  .dance-footer__logo {
    display: block;
    flex-shrink: 0;
  }

  .dance-footer__logo img {
    width: clamp(4.5rem, 9vw, 6.5rem);
    height: auto;
  }

  .dance-footer__nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .dance-footer__nav a {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 400;
    line-height: 1.3;
    color: #ffffff;
    transition: opacity 0.25s ease;
  }

  .dance-footer__nav a:hover,
  .dance-footer__nav a:focus-visible {
    opacity: 0.7;
  }

  .dance-footer__contacts {
    display: flex;
    align-items: start;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 3.5vw, 3.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dance-footer__contact {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .dance-footer__contact-label {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 400;
    line-height: 1.3;
    color: rgb(255 255 255 / 0.42);
  }

  .dance-footer__contact-value {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 500;
    line-height: 1.3;
    color: #ffffff;
    transition: opacity 0.25s ease;
  }

  .dance-footer__contact-value:hover,
  .dance-footer__contact-value:focus-visible {
    opacity: 0.7;
  }

  @media (max-width: 900px) {
    .dance-footer__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }

    .dance-footer__contacts {
      justify-content: flex-start;
    }
  }

  @media (max-width: 560px) {
    .dance-footer__brand {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.15rem;
    }

    .dance-footer__contacts {
      flex-direction: column;
      gap: 1.25rem;
    }
  }
</style>
