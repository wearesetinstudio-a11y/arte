    }

    .dance-hero__meta {
      margin-top: auto;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.85rem;
      padding: 1rem 1.25rem max(2.5rem, env(safe-area-inset-bottom));
      text-align: center;
    }

    .dance-hero__clock,
    .dance-hero__social {
      font-size: 0.68rem;
    }

    .dance-hero__social {
      justify-content: center;
      gap: 0.9rem;
    }
