      padding: 0.34rem 0.65rem;
      font-size: clamp(0.68rem, 2.8vw, 0.82rem);
    }

    .dance-hero__badge--poznan {
      top: calc(36% + 10px);
      left: 10%;
    }

    .dance-hero__badge--taniec {
      top: calc(48% - 20px);
      right: 0;
    }

    .dance-hero__word--offset {
      margin-left: 1.22em;
    }

