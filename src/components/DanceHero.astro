      width: min(30vw, 88px);
    }

    .dance-hero__byline {
      font-size: 0.62rem;
      letter-spacing: 0.08em;
      max-width: 7.5rem;
      white-space: normal;
      line-height: 1.25;
    }

    .dance-hero__links--desktop {
      display: none;
    }

    .dance-hero__menu-toggle {
      display: inline-flex;
      align-items: center;
    }

    .dance-hero__body {
      align-content: start;
      gap: 2.5rem;
      padding: 2.25rem 1rem 0;
      justify-items: center;
    }

    .dance-hero__headline {
      width: max-content;
      max-width: calc(100vw - 1.5rem);
      margin-inline: auto;
      justify-self: center;
