---
const styles = [
  { label: "Broadway Jazz", href: "#kursy-broadway-jazz" },
  { label: "Jazz", href: "#kursy-jazz" },
  { label: "High Heels", href: "#kursy-high-heels" },
  { label: "Performance", href: "#kursy-performance" },
  {
    label: "Trening personalny dla tancerzy",
    href: "#kursy-trening-personalny",
  },
];

const navLinks = [
  { href: "#faq", label: "FAQ" },
  { href: "#kursy", label: "Kursy" },
  { href: "#kontakt", label: "Kontakt" },
];

const socials = [
  { label: "G-mail", href: "mailto:hello@arte.pl" },
  { label: "WhatsApp", href: "#" },
  { label: "Instagram", href: "#" },
];

const tickerItems = [
  "Ostatnie 3 miejsca w tym tygodniu!",
  "Następny tydzień 7 wolnych",
];
// Enough repeats so one track always covers wide viewports
const tickerSequence = Array.from({ length: 8 }, () => tickerItems).flat();
---

<section class="dance-hero" aria-label="Sztuka Ruchu">
  <div class="dance-hero__media" aria-hidden="true">
    <img src="/dance.webp" alt="" width="1920" height="1080" />
  </div>

  <div class="dance-hero__ticker" aria-label="Aktualne wolne miejsca">
    <div class="dance-hero__ticker-track">
      {
        [0, 1].map((copy) => (
          <p
            class="dance-hero__ticker-group"
            aria-hidden={copy === 1 ? "true" : undefined}
          >
            {tickerSequence.map((item) => (
              <span class="dance-hero__ticker-item">
                <span>{item}</span>
                <span aria-hidden="true">|</span>
              </span>
            ))}
          </p>
        ))
      }
    </div>
  </div>

  <header class="dance-hero__nav">
    <div class="dance-hero__brand">
      <a href="/" class="dance-hero__logo" aria-label="Arte — strona główna">
        <img
          src="/arte-logo-white.svg"
          alt="Arte"
          width="658"
          height="376"
        />
      </a>
      <p class="dance-hero__byline">By Viktoria Oskaldowicz</p>
    </div>

    <nav class="dance-hero__links dance-hero__links--desktop" aria-label="Główne">
      {
        navLinks.map((link) => (
          <a href={link.href} class="dance-hero__link">
            <span class="dance-hero__link-track">
              <span>{link.label}</span>
              <span aria-hidden="true">{link.label}</span>
            </span>
          </a>
        ))
      }
    </nav>

    <button
      type="button"
      class="dance-hero__menu-toggle"
      aria-expanded="false"
      aria-controls="dance-hero-menu"
      aria-label="Otwórz menu"
    >
      <span class="dance-hero__menu-toggle-text">Menu</span>
    </button>
  </header>

  <div
    id="dance-hero-menu"
    class="dance-hero__menu"
    hidden
  >
    <nav class="dance-hero__menu-panel" aria-label="Menu mobilne">
      <ul class="dance-hero__menu-list">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="dance-hero__menu-item">
                <span class="dance-hero__menu-item-label">{link.label}</span>
                <img
                  class="dance-hero__menu-item-arrow"
                  src="/arrow.svg"
                  alt=""
                  width="26"
                  height="26"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="dance-hero__body">
    <div class="dance-hero__headline">
      <h1 class="dance-hero__word" data-word>
        Sztuka
        <span class="sr-only"> Ruchu</span>
      </h1>
      <p
        class="dance-hero__word dance-hero__word--offset"
        data-word
        aria-hidden="true"
      >
        Ruchu
      </p>
      <span
        class="dance-hero__badge dance-hero__badge--poznan"
        data-badge
        data-base-rotate="-7"
      >
        #Poznań
      </span>
      <span
        class="dance-hero__badge dance-hero__badge--taniec"
        data-badge
        data-base-rotate="7"
      >
        #Taniec
      </span>
    </div>

    <aside class="dance-hero__aside">
      <ul class="dance-hero__styles" aria-label="Style tańca">
        {
          styles.map((style) => (
            <li>
              <a href={style.href} class="dance-hero__style-link">
                <span class="dance-hero__style-name">{style.label}</span>
                <img
                  class="dance-hero__style-arrow"
                  src="/arrow.svg"
                  alt=""
                  width="26"
                  height="26"
                />
              </a>
            </li>
          ))
        }
      </ul>

      <a href="#kontakt" class="dance-hero__cta">
        <span class="dance-hero__btn-cover" aria-hidden="true"></span>
        <span class="dance-hero__btn-label">Umów się na zajęcia</span>
        <img src="/arrow.svg" alt="" width="26" height="26" />
      </a>
    </aside>
  </div>

  <footer class="dance-hero__meta">
    <p class="dance-hero__clock">
      <span>Poznań</span>
      <span aria-hidden="true">|</span>
      <time datetime="" data-poznan-clock>00:00:00</time>
    </p>

    <ul class="dance-hero__social">
      {
        socials.map((item) => (
          <li>
            <a href={item.href} class="dance-hero__link">
              <span class="dance-hero__link-track">
                <span>{item.label}</span>
                <span aria-hidden="true">{item.label}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </footer>
</section>

<style>
  .dance-hero {
    --text-button: clamp(0.82rem, 1.25vh + 0.2vw, 0.95rem);
    --text-label: clamp(0.82rem, 1.2vh + 0.25vw, 1rem);
    --tracking-label: 0.08em;
    --pad-x: clamp(1.5rem, 4vw, 3.25rem);
    --size-arrow: 0.85rem;

    position: relative;
    isolation: isolate;
    display: flex;
    width: 100%;
    height: 100svh;
    max-height: 100svh;
    flex-direction: column;
    overflow: hidden;
    color: #ffffff;
    background: #0a0a0a;
  }

  .dance-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .dance-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  .dance-hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgb(0 0 0 / 0.55) 0%,
        rgb(0 0 0 / 0.22) 40%,
        rgb(0 0 0 / 0.58) 100%
      );
  }

  .dance-hero__ticker,
  .dance-hero__nav,
  .dance-hero__body,
  .dance-hero__meta,
  .dance-hero__menu {
    position: relative;
    z-index: 1;
  }

  .dance-hero__ticker {
    flex-shrink: 0;
    overflow: hidden;
    background: #000000;
    color: #ffffff;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }

  .dance-hero__ticker-track {
    display: flex;
    width: max-content;
    animation: dance-hero-ticker 90s linear infinite;
  }

  .dance-hero__ticker-group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 1.25rem;
    margin: 0;
    padding: 0.55rem 0;
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 1vh + 0.2vw, 0.82rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .dance-hero__ticker-item {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 1.25rem;
  }

  .dance-hero__ticker-item span[aria-hidden="true"] {
    opacity: 0.45;
  }

  @keyframes dance-hero-ticker {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dance-hero__ticker-track {
      animation: none;
      width: 100%;
      justify-content: center;
    }

    .dance-hero__ticker-group:last-child {
      display: none;
    }

    .dance-hero__ticker-item:nth-child(n + 3) {
      display: none;
    }
  }

  .dance-hero__nav {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.15rem, 2.8vh, 1.85rem) var(--pad-x);
  }

  .dance-hero__brand {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 1.8vw, 1.25rem);
    min-width: 0;
  }

  .dance-hero__logo {
    display: block;
    flex-shrink: 0;
  }

  .dance-hero__logo img {
    width: min(16vw, 96px);
    height: auto;
  }

  .dance-hero__byline {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .dance-hero__links {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 4vw, 3.5rem);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .dance-hero__link {
    --link-line: 1.2em;

    position: relative;
    display: inline-flex;
    height: var(--link-line);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    vertical-align: top;
    line-height: var(--link-line);
  }

  .dance-hero__link-track {
    display: flex;
    flex-direction: column;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .dance-hero__link-track span {
    display: block;
    height: var(--link-line);
    line-height: var(--link-line);
  }

  .dance-hero__link:active .dance-hero__link-track,
  .dance-hero__link:focus-visible .dance-hero__link-track {
    transform: translateY(calc(var(--link-line) * -1));
  }

  @media (hover: hover) and (pointer: fine) {
    .dance-hero__link:hover .dance-hero__link-track {
      transform: translateY(calc(var(--link-line) * -1));
    }
  }

  .dance-hero__menu-toggle {
    display: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    cursor: pointer;
  }

  .dance-hero__menu {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: grid;
    place-items: center;
    background: #ffffff;
    color: #1e1e1e;
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    pointer-events: none;
    transition:
      clip-path 0.55s ease-in-out,
      visibility 0s linear 0.55s;
  }

  .dance-hero__menu.is-open {
    clip-path: inset(0);
    visibility: visible;
    pointer-events: auto;
    transition:
      clip-path 0.55s ease-in-out,
      visibility 0s linear 0s;
  }

  .dance-hero__menu.is-closing {
    clip-path: inset(100% 0 0 0);
    visibility: hidden;
    pointer-events: none;
    transition:
      clip-path 0.55s ease-in-out,
      visibility 0s linear 0.55s;
  }

  .dance-hero__menu[hidden] {
    display: none;
  }

  .dance-hero__menu-panel {
    width: min(100%, 22rem);
    padding-inline: 1.5rem;
    opacity: 0;
    transform: translateY(-0.75rem);
    transition:
      opacity 0.35s ease-in-out 0.12s,
      transform 0.4s ease-in-out 0.12s;
  }

  .dance-hero__menu.is-open .dance-hero__menu-panel {
    opacity: 1;
    transform: translateY(0);
  }

  .dance-hero__menu.is-closing .dance-hero__menu-panel {
    opacity: 0;
    transform: translateY(0.35rem);
    transition:
      opacity 0.25s ease-in-out 0s,
      transform 0.3s ease-in-out 0s;
  }

  .dance-hero__menu-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(30 30 30 / 0.1);
    transition: border-color 0.25s ease;
  }

  .dance-hero__menu-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 1.15rem 0;
    border-bottom: 1px solid rgb(30 30 30 / 0.1);
    color: inherit;
    font-family: var(--font-mono);
    font-size: clamp(0.95rem, 4vw, 1.15rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      border-color 0.3s ease,
      padding 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .dance-hero__menu-item:active,
  .dance-hero__menu-item:focus-visible {
    padding-block: 1.55rem;
  }

  .dance-hero__menu-list li:has(.dance-hero__menu-item:active),
  .dance-hero__menu-list li:has(.dance-hero__menu-item:focus-visible),
  .dance-hero__menu-list
    li:has(+ li .dance-hero__menu-item:active)
    .dance-hero__menu-item,
  .dance-hero__menu-list
    li:has(+ li .dance-hero__menu-item:focus-visible)
    .dance-hero__menu-item {
    border-bottom-color: rgb(30 30 30 / 0.3);
  }

  .dance-hero__menu-list:has(li:first-child .dance-hero__menu-item:active),
  .dance-hero__menu-list:has(
    li:first-child .dance-hero__menu-item:focus-visible
  ) {
    border-top-color: rgb(30 30 30 / 0.3);
  }

  .dance-hero__menu-item-label {
    min-width: 0;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .dance-hero__menu-item-arrow {
    width: var(--size-arrow);
    height: auto;
    flex-shrink: 0;
    transform-origin: center;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .dance-hero__menu-item:active .dance-hero__menu-item-label,
  .dance-hero__menu-item:focus-visible .dance-hero__menu-item-label {
    transform: translateX(10px);
  }

  .dance-hero__menu-item:active .dance-hero__menu-item-arrow,
  .dance-hero__menu-item:focus-visible .dance-hero__menu-item-arrow {
    transform: translateX(-10px) rotate(45deg);
  }

  @media (hover: hover) and (pointer: fine) {
    .dance-hero__menu-item:hover {
      padding-block: 1.55rem;
    }

    .dance-hero__menu-list li:has(.dance-hero__menu-item:hover),
    .dance-hero__menu-list
      li:has(+ li .dance-hero__menu-item:hover)
      .dance-hero__menu-item {
      border-bottom-color: rgb(30 30 30 / 0.3);
    }

    .dance-hero__menu-list:has(li:first-child .dance-hero__menu-item:hover) {
      border-top-color: rgb(30 30 30 / 0.3);
    }

    .dance-hero__menu-item:hover .dance-hero__menu-item-label {
      transform: translateX(10px);
    }

    .dance-hero__menu-item:hover .dance-hero__menu-item-arrow {
      transform: translateX(-10px) rotate(45deg);
    }
  }

  .dance-hero.is-menu-open .dance-hero__ticker,
  .dance-hero.is-menu-open .dance-hero__nav {
    position: relative;
    z-index: 6;
  }

  .dance-hero.is-menu-open .dance-hero__logo img {
    filter: invert(1);
  }

  .dance-hero.is-menu-open .dance-hero__byline,
  .dance-hero.is-menu-open .dance-hero__menu-toggle {
    color: #1e1e1e;
  }

  @media (prefers-reduced-motion: reduce) {
    .dance-hero__menu,
    .dance-hero__menu.is-open,
    .dance-hero__menu.is-closing,
    .dance-hero__menu-panel,
    .dance-hero__menu.is-open .dance-hero__menu-panel,
    .dance-hero__menu.is-closing .dance-hero__menu-panel {
      transition: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dance-hero__link-track {
      transition: none;
    }

    .dance-hero__link:hover .dance-hero__link-track,
    .dance-hero__link:active .dance-hero__link-track,
    .dance-hero__link:focus-visible .dance-hero__link-track {
      transform: none;
    }
  }

  .dance-hero__body {
    display: grid;
    flex: 1;
    grid-template-columns: minmax(0, 1fr) minmax(17rem, 24rem);
    align-items: center;
    gap: clamp(3.5rem, 10vw, 8.5rem);
    min-height: 0;
    padding: 0 var(--pad-x);
  }

  .dance-hero__headline {
    position: relative;
    display: flex;
    width: max-content;
    max-width: 100%;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    perspective: 900px;
    perspective-origin: 50% 45%;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .dance-hero__word {
    display: block;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4.75rem, 13.5vw, 11rem);
    font-weight: 400;
    line-height: 0.8;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    filter: blur(22px);
    transition:
      opacity 1.05s cubic-bezier(0.22, 1, 0.36, 1) 0.12s,
      filter 1.05s cubic-bezier(0.22, 1, 0.36, 1) 0.12s;
  }

  .dance-hero__word--offset {
    margin-top: 0;
    /* Align start of RUCHU with the end of Z in SZTUKA */
    margin-left: 1.22em;
    transition-delay: 0.28s, 0.28s;
  }

  :global(html:not(.is-loading)) .dance-hero__word {
    opacity: 1;
    filter: blur(0);
  }

  .dance-hero__badge {
    --badge-rx: 0deg;
    --badge-ry: 0deg;
    --badge-tx: 0px;
    --badge-ty: 0px;
    --badge-rz: 0deg;

    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.62rem 1.2rem;
    background: #ffffff;
    color: #1e1e1e;
    font-family: var(--font-mono);
    font-size: clamp(0.92rem, 1.35vw, 1.2rem);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    filter: blur(12px);
    transform-style: preserve-3d;
    will-change: transform;
    transform:
      translate3d(var(--badge-tx), var(--badge-ty), 0)
      rotateX(var(--badge-rx))
      rotateY(var(--badge-ry))
      rotateZ(var(--badge-rz));
    transition:
      opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.4s,
      filter 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.4s;
  }

  .dance-hero__badge--poznan {
    top: calc(38% + 10px);
    left: 14%;
    --badge-rz: -7deg;
  }

  .dance-hero__badge--taniec {
    top: calc(46% - 20px);
    right: 4%;
    --badge-rz: 7deg;
    transition-delay: 0.55s, 0.55s;
  }

  :global(html:not(.is-loading)) .dance-hero__badge {
    opacity: 1;
    filter: blur(0);
  }

  .dance-hero__aside {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1.35rem;
    width: 100%;
    max-width: 24rem;
    justify-self: end;
  }

  .dance-hero__styles {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    transition: border-color 0.25s ease;
  }

  .dance-hero__styles li {
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
    transition: border-color 0.3s ease;
  }

  .dance-hero__style-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 1.15rem 0;
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 1.15vw, 0.92rem);
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: inherit;
    transition: padding 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .dance-hero__style-link:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 4px;
  }

  .dance-hero__style-link:active,
  .dance-hero__style-link:focus-visible {
    padding-block: 1.55rem;
  }

  .dance-hero__styles li:has(.dance-hero__style-link:active),
  .dance-hero__styles li:has(.dance-hero__style-link:focus-visible),
  .dance-hero__styles li:has(+ li .dance-hero__style-link:active),
  .dance-hero__styles li:has(+ li .dance-hero__style-link:focus-visible) {
    border-bottom-color: rgb(255 255 255 / 0.3);
  }

  .dance-hero__styles:has(li:first-child .dance-hero__style-link:active),
  .dance-hero__styles:has(
    li:first-child .dance-hero__style-link:focus-visible
  ) {
    border-top-color: rgb(255 255 255 / 0.3);
  }

  .dance-hero__style-name {
    min-width: 0;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .dance-hero__style-arrow {
    width: var(--size-arrow);
    height: auto;
    flex-shrink: 0;
    filter: brightness(0) invert(1);
    transform-origin: center;
