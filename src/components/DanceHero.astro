</style>

<script>
  const clockEl = document.querySelector<HTMLTimeElement>("[data-poznan-clock]");

  const formatPoznanTime = (date: Date) =>
    new Intl.DateTimeFormat("pl-PL", {
      timeZone: "Europe/Warsaw",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    }).format(date);

  const tickClock = () => {
    if (!clockEl) return;
    const now = new Date();
    const label = formatPoznanTime(now);
    clockEl.textContent = label;
    clockEl.dateTime = now.toISOString();
  };

  tickClock();
  window.setInterval(tickClock, 1000);

  const scrollToContact = (event: Event) => {
    const target = document.querySelector<HTMLElement>("#kontakt");
    if (!target) return;

    event.preventDefault();
    target.scrollIntoView({ behavior: "smooth", block: "start" });
    history.pushState(null, "", "#kontakt");
  };

  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    '.dance-hero a[href="#kontakt"]',
  )) {
    link.addEventListener("click", scrollToContact);
  }

  const heroEl = document.querySelector<HTMLElement>(".dance-hero");
  const menuToggle = document.querySelector<HTMLButtonElement>(
    ".dance-hero__menu-toggle",
  );
  const menu = document.querySelector<HTMLElement>("#dance-hero-menu");
  const menuToggleText = menuToggle?.querySelector<HTMLElement>(
    ".dance-hero__menu-toggle-text",
  );

  if (heroEl && menuToggle && menu && menuToggleText) {
    const MENU_MS = 550;
    let menuBusy = false;
    let menuTimer = 0;

    const setMenuOpen = (open: boolean) => {
      if (menuBusy && open) return;
      const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
      if (open === isOpen) return;

      window.clearTimeout(menuTimer);
      menuBusy = true;

      menuToggle.setAttribute("aria-expanded", String(open));
      menuToggle.setAttribute(
        "aria-label",
        open ? "Zamknij menu" : "Otwórz menu",
      );
      menuToggleText.textContent = open ? "Zamknij" : "Menu";
      heroEl.classList.toggle("is-menu-open", open);

      if (open) {
        menu.hidden = false;
        menu.classList.remove("is-closing", "is-open");
        void menu.offsetWidth;
        menu.classList.add("is-open");
        menuTimer = window.setTimeout(() => {
          menuBusy = false;
        }, MENU_MS);
        return;
      }

      menu.classList.remove("is-open");
      menu.classList.add("is-closing");
      menuTimer = window.setTimeout(() => {
        menu.classList.remove("is-closing");
        menu.hidden = true;
        menuBusy = false;
      }, MENU_MS);
    };

    menuToggle.addEventListener("click", () => {
      const open = menuToggle.getAttribute("aria-expanded") !== "true";
      setMenuOpen(open);
    });

    menu.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest("a") || target === menu) {
        setMenuOpen(false);
      }
    });

    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setMenuOpen(false);
    });
  }

  const hero = document.querySelector<HTMLElement>(".dance-hero");
  const badges = [
    ...document.querySelectorAll<HTMLElement>("[data-badge]"),
  ];
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const finePointer = window.matchMedia("(pointer: fine)").matches;

  if (hero && badges.length && !reduceMotion) {
    const MAX_TILT = 18;
    const MAX_PULL = 14;
    const RANGE = 320;
    const EASE = 0.14;
    const SCROLL_TILT_X = 68;
    const SCROLL_TILT_Y = 48;
    const SCROLL_PULL = 44;

    type Tilt = { rx: number; ry: number; tx: number; ty: number };

    const state = badges.map((el) => ({
      el,
      current: { rx: 0, ry: 0, tx: 0, ty: 0 } as Tilt,
      target: { rx: 0, ry: 0, tx: 0, ty: 0 } as Tilt,
    }));

    let frame = 0;
    let active = false;

    const apply = (el: HTMLElement, tilt: Tilt) => {
      el.style.setProperty("--badge-rx", `${tilt.rx.toFixed(2)}deg`);
      el.style.setProperty("--badge-ry", `${tilt.ry.toFixed(2)}deg`);
      el.style.setProperty("--badge-tx", `${tilt.tx.toFixed(2)}px`);
      el.style.setProperty("--badge-ty", `${tilt.ty.toFixed(2)}px`);
    };

    const render = () => {
      frame = 0;
      let moving = false;

      for (const item of state) {
        item.current.rx += (item.target.rx - item.current.rx) * EASE;
        item.current.ry += (item.target.ry - item.current.ry) * EASE;
        item.current.tx += (item.target.tx - item.current.tx) * EASE;
        item.current.ty += (item.target.ty - item.current.ty) * EASE;
        apply(item.el, item.current);

        if (
          Math.abs(item.target.rx - item.current.rx) > 0.05 ||
          Math.abs(item.target.ry - item.current.ry) > 0.05 ||
          Math.abs(item.target.tx - item.current.tx) > 0.05 ||
          Math.abs(item.target.ty - item.current.ty) > 0.05
        ) {
          moving = true;
        }
      }

      if (moving || active) {
        frame = window.requestAnimationFrame(render);
      }
    };

    const requestRender = () => {
      if (!frame) frame = window.requestAnimationFrame(render);
    };

    if (finePointer) {
      const setTargetsFromPoint = (x: number, y: number) => {
        for (const item of state) {
          const rect = item.el.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          const nx = Math.max(-1, Math.min(1, (x - cx) / RANGE));
          const ny = Math.max(-1, Math.min(1, (y - cy) / RANGE));

          item.target.rx = -ny * MAX_TILT;
          item.target.ry = nx * MAX_TILT;
          item.target.tx = nx * MAX_PULL;
          item.target.ty = ny * MAX_PULL;
        }
      };

      hero.addEventListener(
        "pointermove",
        (event) => {
          if (event.pointerType === "touch") return;
          active = true;
          setTargetsFromPoint(event.clientX, event.clientY);
          requestRender();
        },
        { passive: true },
      );

      hero.addEventListener(
        "pointerleave",
        () => {
          active = false;
          for (const item of state) {
            item.target.rx = 0;
            item.target.ry = 0;
            item.target.tx = 0;
            item.target.ty = 0;
          }
          requestRender();
        },
        { passive: true },
      );
    } else {
      const setTargetsFromScroll = () => {
        const rect = hero.getBoundingClientRect();
        const travel = Math.max(rect.height * 0.32, 1);
        const progress = Math.max(0, Math.min(1, -rect.top / travel));

        state.forEach((item, index) => {
          const dir = index % 2 === 0 ? -1 : 1;
          item.target.rx = progress * SCROLL_TILT_X;
          item.target.ry = progress * SCROLL_TILT_Y * dir;
          item.target.tx = progress * SCROLL_PULL * dir * 0.55;
          item.target.ty = progress * SCROLL_PULL * 0.85;
        });
      };

      const onScroll = () => {
        active = true;
        setTargetsFromScroll();
        requestRender();
      };

      setTargetsFromScroll();
      requestRender();
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
    }
  }
</script>
