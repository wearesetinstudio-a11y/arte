---
interface Review {
  quote: string;
  name: string;
  role: string;
}

interface Props {
  kicker?: string;
  reviews?: Review[];
}

const {
  kicker = "Opinie klientów",
  reviews = [
    {
      quote:
        "Taniec to nie powtarzalność układu lecz mechanika i świadomość ciała. W Arte de Baile pracujemy u podstaw ponieważ technika daje precyzję i swobodę ruchu a motoryka przygotowuje ciało na pełną kontrolę",
      name: "Anka Bartosik",
      role: "Uczestniczy w kursie high heels",
    },
    {
      quote:
        "Wreszcie czuję, że ciało pracuje ze mną, a nie przeciwko mnie. Tempo zajęć jest wymagające, ale prowadzenie jest precyzyjne i bardzo uważne.",
      name: "Maja Nowak",
      role: "Uczestniczy w kursie broadway jazz",
    },
    {
      quote:
        "Trening personalny w Arte pomógł mi wrócić do formy po przerwie. Technika, motoryka i świadomość ruchu — wszystko ułożone w spójną całość.",
      name: "Kasia Wróbel",
      role: "Trening personalny",
    },
  ],
} = Astro.props;
---

<section
  class="dance-reviews"
  data-reviews
  aria-labelledby="reviews-heading"
>
  <div class="dance-reviews__inner">
    <header class="dance-reviews__header">
      <h2 id="reviews-heading" class="dance-reviews__kicker">{kicker}</h2>

      <div class="dance-reviews__nav" role="group" aria-label="Nawigacja opinii">
        <button
          type="button"
          class="dance-reviews__arrow dance-reviews__arrow--prev"
          data-reviews-prev
          aria-label="Poprzednia opinia"
        >
          <img src="/arrow.svg" alt="" width="26" height="26" />
        </button>
        <button
          type="button"
          class="dance-reviews__arrow dance-reviews__arrow--next"
          data-reviews-next
          aria-label="Następna opinia"
        >
          <img src="/arrow.svg" alt="" width="26" height="26" />
        </button>
      </div>
    </header>

    <div class="dance-reviews__body">
      <div class="dance-reviews__quotes" data-reviews-quotes>
        {
          reviews.map((review, index) => (
            <p
              class:list={[
                "dance-reviews__quote",
                index === 0 && "is-active",
              ]}
              data-reviews-quote
              aria-hidden={index === 0 ? "false" : "true"}
            >
              {review.quote}
            </p>
          ))
        }
      </div>

      <div class="dance-reviews__metas" data-reviews-metas>
        {
          reviews.map((review, index) => (
            <footer
              class:list={[
                "dance-reviews__meta",
                index === 0 && "is-active",
              ]}
              data-reviews-meta
              aria-hidden={index === 0 ? "false" : "true"}
              {...(index === 0 ? {} : { inert: true })}
            >
              <p class="dance-reviews__name">{review.name}</p>
              <p class="dance-reviews__role">{review.role}</p>
            </footer>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .dance-reviews {
    background: #fafafa;
    color: #1e1e1e;
    padding: clamp(4.5rem, 12vh, 7.5rem) clamp(1.5rem, 4vw, 3.25rem);
  }

  .dance-reviews__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 6vh, 4.5rem);
    width: min(100%, 78rem);
    margin-inline: auto;
  }

  .dance-reviews__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .dance-reviews__kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    line-height: 1.4;
    text-transform: uppercase;
  }

  .dance-reviews__nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
    gap: 0.5rem;
  }

  .dance-reviews__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(0 0 0 / 0.04);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .dance-reviews__arrow:active {
    background: rgb(0 0 0 / 0.1);
  }

  .dance-reviews__arrow:focus:not(:focus-visible) {
    outline: none;
  }

  .dance-reviews__arrow:focus-visible {
    background: rgb(0 0 0 / 0.1);
    outline: 1px solid #1e1e1e;
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .dance-reviews__arrow:hover {
      background: rgb(0 0 0 / 0.1);
    }
  }

  .dance-reviews__arrow img {
    width: var(--size-arrow);
    height: var(--size-arrow);
  }

  .dance-reviews__arrow--prev img {
    transform: rotate(-135deg);
  }

  .dance-reviews__arrow--next img {
    transform: rotate(45deg);
  }

  .dance-reviews__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .dance-reviews__quotes,
  .dance-reviews__metas {
    position: relative;
    display: grid;
  }

  .dance-reviews__quotes {
    min-width: 0;
  }

  .dance-reviews__metas {
    align-self: start;
    min-width: max-content;
  }

  .dance-reviews__quote,
  .dance-reviews__meta {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate3d(0, 0.4rem, 0);
    transition:
      opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.55s;
  }

  .dance-reviews__quote.is-active,
  .dance-reviews__meta.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate3d(0, 0, 0);
    transition:
      opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0s;
  }

  .dance-reviews__quote {
    margin: 0;
    max-width: 38rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 0.95rem + 1.1vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.028em;
    line-height: 1.28;
    text-wrap: pretty;
  }

  .dance-reviews__meta {
    margin: 0;
  }

  .dance-reviews__name {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1rem, 0.92rem + 0.3vw, 1.15rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .dance-reviews__role {
    margin: 0.45rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.4;
    color: var(--color-muted);
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .dance-reviews__inner {
      gap: 1.75rem;
    }

    .dance-reviews__body {
      grid-template-columns: 1fr;
      row-gap: 1.75rem;
    }

    .dance-reviews__metas {
      min-width: 0;
    }

    .dance-reviews__quote {
      font-size: clamp(1.25rem, 5.2vw, 1.55rem);
      line-height: 1.32;
      max-width: none;
    }

    .dance-reviews__role {
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dance-reviews__quote,
    .dance-reviews__meta {
      transform: none;
      transition: none;
    }

    .dance-reviews__quote:not(.is-active),
    .dance-reviews__meta:not(.is-active) {
      visibility: hidden;
    }
  }
</style>

<script>
  function initReviews(root: HTMLElement) {
    if (root.dataset.reviewsReady === "true") return;
    root.dataset.reviewsReady = "true";

    const quotes = [
      ...root.querySelectorAll<HTMLElement>("[data-reviews-quote]"),
    ];
    const metas = [
      ...root.querySelectorAll<HTMLElement>("[data-reviews-meta]"),
    ];
    if (quotes.length < 2) return;

    const prev = root.querySelector<HTMLButtonElement>("[data-reviews-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-reviews-next]");

    let index = quotes.findIndex((quote) =>
      quote.classList.contains("is-active"),
    );
    if (index < 0) index = 0;

    const sync = (activeIndex: number) => {
      quotes.forEach((quote, i) => {
        const active = i === activeIndex;
        quote.classList.toggle("is-active", active);
        quote.setAttribute("aria-hidden", active ? "false" : "true");
      });

      metas.forEach((meta, i) => {
        const active = i === activeIndex;
        meta.classList.toggle("is-active", active);
        meta.setAttribute("aria-hidden", active ? "false" : "true");
        if (active) meta.removeAttribute("inert");
        else meta.setAttribute("inert", "");
      });
    };

    const show = (target: number) => {
      const nextIndex = (target + quotes.length) % quotes.length;
      if (nextIndex === index) return;
      index = nextIndex;
      sync(index);
    };

    prev?.addEventListener("click", () => show(index - 1));
    next?.addEventListener("click", () => show(index + 1));
  }

  function boot() {
    document
      .querySelectorAll<HTMLElement>("[data-reviews]")
      .forEach(initReviews);
  }

  boot();
  document.addEventListener("astro:page-load", boot);
</script>
