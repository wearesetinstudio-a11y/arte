---
interface Props {
  kicker?: string;
  statement?: string;
  lines?: string[];
}

const {
  kicker = "Ruch, który wyraża więcej.",
  statement = "Taniec to nie powtarzalność układu lecz mechanika i świadomość ciała. W Arte de Baile pracujemy u podstaw ponieważ technika daje precyzję i swobodę ruchu a motoryka przygotowuje ciało na pełną kontrolę",
  lines,
} = Astro.props;

const copy = lines?.length ? lines.join(" ") : statement;
const words = copy.split(/\s+/).filter(Boolean);

const rails = [
  {
    id: "left",
    from: -56,
    speed: 1.05,
    images: [
      { src: "/value_1.webp", x: 50 },
      { src: "/value_2.webp", x: 0 },
      { src: "/value_3.webp", x: 28 },
    ],
  },
  {
    id: "right",
    from: -42,
    speed: 1.25,
    images: [
      { src: "/value_4.webp", x: -40 },
      { src: "/value_5.webp", x: 0 },
      { src: "/value_6.webp", x: -130 },
    ],
  },
];
---

<section class="dance-value" data-value aria-labelledby="value-statement">
  <div class="dance-value__pin">
    <div class="dance-value__frames" aria-hidden="true">
      {
        rails.map((rail) => (
          <div
            class={`dance-value__rail dance-value__rail--${rail.id}`}
            data-rail
            data-from={rail.from}
            data-speed={rail.speed}
          >
            {rail.images.map((image) => (
              <figure
                class="dance-value__frame"
                style={`--frame-x: ${image.x}px`}
              >
                <img
                  src={image.src}
                  alt=""
                  width="640"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))}
          </div>
        ))
      }
    </div>

    <div class="dance-value__inner">
      <p class="dance-value__kicker">{kicker}</p>
      <h2 id="value-statement" class="dance-value__statement">
        {
          words.map((word, index) => (
            <span class="dance-value__word" data-word>
              {word}
              {index < words.length - 1 ? " " : ""}
            </span>
          ))
        }
      </h2>
    </div>
  </div>
</section>

<style>
  .dance-value {
    --value-ink: #1e1e1e;
    --value-muted: #d4d4d4;
    --rail-gap: clamp(4.5rem, 10vh, 7rem);

    position: relative;
    height: 320vh;
    background: #ffffff;
    color: var(--value-ink);
  }

  .dance-value__pin {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100svh;
    overflow: hidden;
    padding: clamp(4.5rem, 12vh, 7.5rem) clamp(1.5rem, 4vw, 3.25rem);
  }

  .dance-value__frames {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .dance-value__rail {
    --shift: 0vh;

    position: absolute;
    top: 0;
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
    width: clamp(7rem, 11vw, 9.5rem);
    will-change: transform;
    transform: translate3d(0, var(--shift), 0);
  }

  .dance-value__rail--left {
    left: max(0.75rem, calc(50% - 21rem - 13rem));
  }

  .dance-value__rail--left .dance-value__frame:first-child {
    margin-top: -5rem;
  }

  .dance-value__rail--right {
    right: max(0.75rem, calc(50% - 21rem - 13rem));
  }

  .dance-value__rail--right .dance-value__frame:last-child {
    margin-bottom: -5rem;
  }

  .dance-value__frame {
    --frame-x: 0px;

    margin: 0;
    overflow: hidden;
    background: #cfcfcf;
    width: 100%;
    aspect-ratio: 4 / 5;
    flex-shrink: 0;
    transform: translate3d(var(--frame-x), 0, 0);
  }

  .dance-value__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .dance-value__inner {
    position: relative;
    z-index: 2;
    width: min(100%, 42rem);
    margin-inline: auto;
    text-align: center;
  }

  .dance-value__kicker {
    margin: 0 0 1.35rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    line-height: 1.4;
    text-transform: uppercase;
  }

  .dance-value__statement {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 1rem + 1.2vw, 2.15rem);
    font-weight: 500;
    letter-spacing: -0.028em;
    line-height: 1.22;
    text-wrap: pretty;
  }

  .dance-value__word {
    --ink: 0;
    color: color-mix(
      in srgb,
      var(--value-ink) calc(var(--ink) * 100%),
      var(--value-muted)
    );
  }

  @media (max-width: 720px) {
    .dance-value {
      height: 280vh;
      --rail-gap: clamp(5.5rem, 16vh, 9rem);
    }

    .dance-value__pin {
      padding-inline: clamp(1.25rem, 5vw, 2rem);
    }

    .dance-value__inner {
      width: min(100%, 17.5rem);
      z-index: 2;
    }

    .dance-value__statement {
      font-size: clamp(1.35rem, 5.8vw, 1.75rem);
      line-height: 1.28;
    }

    .dance-value__rail {
      width: min(22vw, 5.25rem);
    }

    .dance-value__rail--left {
      left: 0.35rem;
    }

    .dance-value__rail--left .dance-value__frame:nth-child(1) {
      margin-top: -8rem;
      --frame-x: 0px !important;
    }

    .dance-value__rail--left .dance-value__frame:nth-child(2) {
      --frame-x: 14px !important;
    }

    .dance-value__rail--left .dance-value__frame:nth-child(3) {
      margin-top: 1rem;
      --frame-x: 4px !important;
    }

    .dance-value__rail--right {
      right: 0.35rem;
    }

    .dance-value__rail--right .dance-value__frame:nth-child(1) {
      margin-top: 4.5rem;
      --frame-x: 0px !important;
    }

    .dance-value__rail--right .dance-value__frame:nth-child(2) {
      margin-top: 0.75rem;
      --frame-x: -12px !important;
    }

    .dance-value__rail--right .dance-value__frame:nth-child(3) {
      margin-top: 1.25rem;
      margin-bottom: -8rem;
      --frame-x: 0px !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dance-value {
      height: auto;
    }

    .dance-value__pin {
      position: relative;
      height: auto;
      overflow: visible;
      padding-block: clamp(5rem, 14vh, 8rem);
    }

    .dance-value__frames {
      display: none;
    }

    .dance-value__word {
      --ink: 1;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-value]");

  if (section) {
    const words = [...section.querySelectorAll<HTMLElement>("[data-word]")];
    const rails = [...section.querySelectorAll<HTMLElement>("[data-rail]")];
    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const clamp = (value: number, min: number, max: number) =>
      Math.min(max, Math.max(min, value));

    const paintWords = (amount: number) => {
      const count = words.length;
      if (!count) return;

      const blend = 1.65;
      const cursor = amount * (count - 1 + blend);

      for (let i = 0; i < count; i++) {
        const local = clamp((cursor - i) / blend, 0, 1);
        const eased = local * local * (3 - 2 * local);
        words[i].style.setProperty("--ink", eased.toFixed(3));
      }
    };

    const flowFrames = (progress: number) => {
      const travel = 110;

      for (const rail of rails) {
        const from = Number(rail.dataset.from ?? -40);
        const speed = Number(rail.dataset.speed ?? 1);
        const shift = from + travel * speed * progress;
        rail.style.setProperty("--shift", `${shift.toFixed(2)}vh`);
      }
    };

    if (!reduce) {
      let frame = 0;

      const update = () => {
        frame = 0;
        const travel = section.offsetHeight - window.innerHeight;
        const raw =
          travel <= 0
            ? 1
            : clamp(-section.getBoundingClientRect().top / travel, 0, 1);

        paintWords(clamp((raw - 0.08) / 0.78, 0, 1));
        flowFrames(raw);
      };

      const requestUpdate = () => {
        if (frame) return;
        frame = requestAnimationFrame(update);
      };

      update();
      window.addEventListener("scroll", requestUpdate, { passive: true });
      window.addEventListener("resize", requestUpdate);
    }
  }
</script>
