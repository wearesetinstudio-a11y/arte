---
interface Props {
  kicker?: string;
  statement?: string;
  lines?: string[];
}

const {
  kicker = "Ruch, który wyraża więcej.",
  statement = "Taniec to nie powtarzalność układu lecz mechanika i świadomość ciała. W Arte de Baile pracujemy u podstaw ponieważ technika daje precyzję i swobodę ruchu a motoryka przygotowuje ciało na pełną kontrolę",
  lines,
} = Astro.props;

const copy = lines?.length ? lines.join(" ") : statement;
const words = copy.split(/\s+/).filter(Boolean);

const stripImages = [
  "/value_1.webp",
  "/value_2.webp",
  "/value_3.webp",
  "/value_4.webp",
  "/value_5.webp",
  "/value_6.webp",
];

const rails = [
  {
    id: "left",
    from: -56,
    speed: 1.05,
    images: [
      { src: "/value_1.webp", x: 50 },
      { src: "/value_2.webp", x: 0 },
      { src: "/value_3.webp", x: 28 },
    ],
  },
  {
    id: "right",
    from: -42,
    speed: 1.25,
    images: [
      { src: "/value_4.webp", x: -40 },
      { src: "/value_5.webp", x: 0 },
      { src: "/value_6.webp", x: -130 },
    ],
  },
];
---

<section class="dance-value" data-value aria-labelledby="value-statement">
  <div class="dance-value__pin">
    <div class="dance-value__frames" aria-hidden="true">
      {
        rails.map((rail) => (
          <div
            class={`dance-value__rail dance-value__rail--${rail.id}`}
            data-rail
            data-from={rail.from}
            data-speed={rail.speed}
          >
            {rail.images.map((image) => (
              <figure
                class="dance-value__frame"
                style={`--frame-x: ${image.x}px`}
              >
                <img
                  src={image.src}
                  alt=""
                  width="640"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))}
          </div>
        ))
      }
    </div>

    <div class="dance-value__strip" data-value-strip aria-hidden="true">
      <div class="dance-value__strip-track" data-strip-track>
        {
          stripImages.map((src, index) => (
            <figure
              class="dance-value__strip-frame"
              data-strip-frame
              style={`--stagger: ${index * 2}px`}
            >
              <img
                src={src}
                alt=""
                width="640"
                height="800"
                loading="lazy"
                decoding="async"
              />
            </figure>
          ))
        }
      </div>
    </div>

    <div class="dance-value__inner">
      <p class="dance-value__kicker">{kicker}</p>
      <h2 id="value-statement" class="dance-value__statement">
        {
          words.map((word, index) => (
            <span class="dance-value__word" data-word>
              {word}
              {index < words.length - 1 ? " " : ""}
            </span>
          ))
        }
      </h2>
    </div>
  </div>
</section>

<style>
  .dance-value {
    --value-ink: #1e1e1e;
    --value-muted: #d4d4d4;
    --rail-gap: clamp(4.5rem, 10vh, 7rem);

    position: relative;
    height: 320vh;
    background: #ffffff;
    color: var(--value-ink);
  }

  .dance-value__pin {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100svh;
    overflow: hidden;
    padding: clamp(4.5rem, 12vh, 7.5rem) clamp(1.5rem, 4vw, 3.25rem);
  }

  .dance-value__frames {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .dance-value__strip {
    display: none;
  }

  .dance-value__rail {
    --shift: 0vh;

    position: absolute;
    top: 0;
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
    width: clamp(9rem, 15vw, 13rem);
    will-change: transform;
    transform: translate3d(0, var(--shift), 0);
  }

  .dance-value__rail--left {
    left: max(0.75rem, calc(50% - 21rem - 15rem));
  }

  .dance-value__rail--left .dance-value__frame:first-child {
    margin-top: -5rem;
  }

  .dance-value__rail--right {
    right: max(0.75rem, calc(50% - 21rem - 15rem));
  }

  .dance-value__rail--right .dance-value__frame:last-child {
    margin-bottom: -5rem;
  }

  .dance-value__frame {
    --frame-x: 0px;

    margin: 0;
    overflow: hidden;
    background: #cfcfcf;
    width: 100%;
    aspect-ratio: 4 / 5;
    flex-shrink: 0;
    transform: translate3d(var(--frame-x), 0, 0);
  }

  .dance-value__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .dance-value__inner {
    position: relative;
    z-index: 2;
    width: min(100%, 42rem);
    margin-inline: auto;
    text-align: center;
  }

  .dance-value__kicker {
    margin: 0 0 1.35rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    line-height: 1.4;
    text-transform: uppercase;
  }

  .dance-value__statement {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 1rem + 1.2vw, 2.15rem);
    font-weight: 500;
    letter-spacing: -0.028em;
    line-height: 1.22;
    text-wrap: pretty;
  }

  .dance-value__word {
    --ink: 0;
    color: color-mix(
      in srgb,
      var(--value-ink) calc(var(--ink) * 100%),
      var(--value-muted)
    );
  }

  @media (max-width: 720px) {
    .dance-value {
      height: 560vh;
    }

    .dance-value__pin {
      top: 0;
      flex-direction: column;
      justify-content: flex-start;
      align-items: stretch;
      gap: clamp(1.25rem, 3.5vh, 2rem);
      padding: clamp(2.75rem, 6vh, 4rem) 0 calc(5.5rem + env(safe-area-inset-bottom, 0px));
    }

    .dance-value__frames {
      display: none;
    }

    .dance-value__strip {
      display: block;
      width: 100%;
      overflow: hidden;
      flex-shrink: 0;
      pointer-events: auto;
      touch-action: none;
      z-index: 1;
      padding-bottom: 10px;
      cursor: grab;
    }

    .dance-value__strip-track {
      --pan: 0px;

      display: flex;
      align-items: flex-start;
      gap: 0.55rem;
      width: max-content;
      padding-inline: 0.75rem;
      will-change: transform;
      transform: translate3d(var(--pan), 0, 0);
    }

    .dance-value__strip-frame {
      --stagger: 0px;

      margin: 0;
      overflow: hidden;
      background: #cfcfcf;
      width: 46vw;
      aspect-ratio: 4 / 5;
      flex-shrink: 0;
      transform: translate3d(0, var(--stagger), 0);
    }

    .dance-value__strip-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .dance-value__inner {
      width: min(100% - 2.5rem, 20rem);
      margin-inline: auto;
      z-index: 2;
    }

    .dance-value__statement {
      font-size: clamp(1.35rem, 5.8vw, 1.75rem);
      line-height: 1.28;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dance-value {
      height: auto;
    }

    .dance-value__pin {
      position: relative;
      height: auto;
      overflow: visible;
      padding-block: clamp(5rem, 14vh, 8rem);
    }

    .dance-value__frames,
    .dance-value__strip {
      display: none;
    }

    .dance-value__word {
      --ink: 1;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-value]");

  if (section) {
    const words = [...section.querySelectorAll<HTMLElement>("[data-word]")];
    const rails = [...section.querySelectorAll<HTMLElement>("[data-rail]")];
    const strip = section.querySelector<HTMLElement>("[data-value-strip]");
    const track = section.querySelector<HTMLElement>("[data-strip-track]");
    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const mobile = window.matchMedia("(max-width: 720px)");

    const clamp = (value: number, min: number, max: number) =>
      Math.min(max, Math.max(min, value));

    const ease = (t: number) => t * t * (3 - 2 * t);

    const paintWords = (amount: number) => {
      const count = words.length;
      if (!count) return;

      const blend = 1.65;
      const cursor = amount * (count - 1 + blend);

      for (let i = 0; i < count; i++) {
        const local = clamp((cursor - i) / blend, 0, 1);
        words[i].style.setProperty("--ink", ease(local).toFixed(3));
      }
    };

    const flowRails = (progress: number) => {
      const travel = 110;

      for (const rail of rails) {
        const from = Number(rail.dataset.from ?? -40);
        const speed = Number(rail.dataset.speed ?? 1);
        const shift = from + travel * speed * progress;
        rail.style.setProperty("--shift", `${shift.toFixed(2)}vh`);
      }
    };

    const flowStrip = (amount: number) => {
      if (!strip || !track) return;
      const maxPan = Math.max(0, track.scrollWidth - strip.clientWidth);
      track.style.setProperty(
        "--pan",
        `${(-(ease(amount) * maxPan)).toFixed(2)}px`,
      );
    };

    const progressFromWindow = () => {
      const travel = section.offsetHeight - window.innerHeight;
      if (travel <= 0) return 1;
      return clamp(-section.getBoundingClientRect().top / travel, 0, 1);
    };

    const textFromProgress = (raw: number) =>
      clamp((raw - 0.08) / 0.78, 0, 1);

    const scrollWindowToProgress = (raw: number) => {
      const travel = section.offsetHeight - window.innerHeight;
      if (travel <= 0) return;
      const sectionTop =
        window.scrollY + section.getBoundingClientRect().top;
      window.scrollTo({ top: sectionTop + clamp(raw, 0, 1) * travel });
    };

    if (!reduce) {
      let frame = 0;
      let dragging = false;
      let startX = 0;
      let startRaw = 0;

      const update = () => {
        frame = 0;
        const raw = progressFromWindow();
        const textAmount = textFromProgress(raw);

        paintWords(textAmount);

        if (mobile.matches) {
          flowStrip(textAmount);
        } else {
          flowRails(raw);
        }
      };

      const requestUpdate = () => {
        if (frame) return;
        frame = requestAnimationFrame(update);
      };

      const panWidth = () => {
        if (!strip || !track) return 1;
        return Math.max(1, track.scrollWidth - strip.clientWidth);
      };

      const onPointerDown = (event: PointerEvent) => {
        if (!mobile.matches || !strip) return;
        dragging = true;
        startX = event.clientX;
        startRaw = progressFromWindow();
        strip.setPointerCapture(event.pointerId);
        strip.style.cursor = "grabbing";
      };

      const onPointerMove = (event: PointerEvent) => {
        if (!dragging || !mobile.matches) return;
        const dx = event.clientX - startX;
        // Swipe left → progress forward (same as scrolling down)
        const delta = (-dx / panWidth()) * 0.78;
        scrollWindowToProgress(startRaw + delta);
        requestUpdate();
      };

      const onPointerUp = (event: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        if (strip?.hasPointerCapture(event.pointerId)) {
          strip.releasePointerCapture(event.pointerId);
        }
        if (strip) strip.style.cursor = "grab";
      };

      update();
      window.addEventListener("scroll", requestUpdate, { passive: true });
      window.addEventListener("resize", requestUpdate);
      mobile.addEventListener("change", requestUpdate);

      strip?.addEventListener("pointerdown", onPointerDown);
      strip?.addEventListener("pointermove", onPointerMove);
      strip?.addEventListener("pointerup", onPointerUp);
      strip?.addEventListener("pointercancel", onPointerUp);
    }
  }
</script>
