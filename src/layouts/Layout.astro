---
import "../styles/global.css";
import Preloader from "../components/Preloader.astro";

interface Props {
  title?: string;
  description?: string;
  lockScroll?: boolean;
}

const {
  title = "Arte — Languages & Dance",
  description = "Arte — languages and dance. An artistic space for expression, movement, and connection.",
  lockScroll = false,
} = Astro.props;
---

<!doctype html>
<html lang="pl" class:list={["is-loading", { "is-locked": lockScroll }]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon-black.svg"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon-white.svg"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" href="/favicon.ico" />

    <!-- Google Fonts: Geist (headlines + copy) + Geist Mono (buttons + labels) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <script is:inline>
      (function () {
        try {
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            document.documentElement.classList.remove("is-loading");
            return;
          }
        } catch (_) {}

        // Hard failsafe if the Lottie module fails to load
        window.setTimeout(function () {
          var root = document.documentElement;
          var preloader = document.getElementById("preloader");
          if (!root.classList.contains("is-loading")) return;
          root.classList.remove("is-loading");
          if (preloader) {
            preloader.classList.add("is-done");
            window.setTimeout(function () {
              preloader.remove();
            }, 700);
          }
        }, 6000);
      })();
    </script>
  </head>
  <body
    class:list={[
      "antialiased",
      lockScroll ? "is-dark-surface" : "bg-void text-ink",
    ]}
  >
    <Preloader />
    <slot />

    <script is:inline>
      (function () {
        const originalTitle = document.title;
        const awayTitle = "Let's dance!";

        document.addEventListener("visibilitychange", () => {
          document.title =
            document.visibilityState === "hidden" ? awayTitle : originalTitle;
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  html.is-locked,
  html.is-locked body {
    height: 100%;
    overflow: hidden;
  }

  html.is-locked {
    overflow-y: hidden;
    scrollbar-gutter: auto;
  }

  body.is-dark-surface {
    background: #0a0a0a;
    color: #ffffff;
  }
</style>
