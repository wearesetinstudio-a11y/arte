---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Strona nie znaleziona | Arte de Baile"
  description="Ta strona nie istnieje lub zmieniła lokalizację. Wróć do strony głównej Arte de Baile."
  preloader={false}
  robots="noindex, nofollow"
>
  <main class="error-page">
    <div class="error-page__inner">
      <div class="error-page__headline">
        <h1 class="error-page__title">UPSSS...</h1>
        <span class="error-page__badge error-page__badge--poznan" data-badge>
          <span class="error-page__badge-flip">
            <span class="error-page__badge-face error-page__badge-face--front">
              #Poznań
            </span>
            <span class="error-page__badge-face error-page__badge-face--back">
              #Nauka
            </span>
          </span>
        </span>
        <span class="error-page__badge error-page__badge--taniec" data-badge>
          <span class="error-page__badge-flip">
            <span class="error-page__badge-face error-page__badge-face--front">
              #Taniec
            </span>
            <span class="error-page__badge-face error-page__badge-face--back">
              #Pasja
            </span>
          </span>
        </span>
      </div>

      <div class="error-page__footer">
        <p class="error-page__copy">
          Ta strona nie istnieje lub zmieniła lokalizację. Wróć do strony
          głównej lub skontaktuj się z nami bezpośrednio, aby trafić we właściwe
          miejsce.
        </p>

        <a href="/" class="error-page__cta">
          <span class="error-page__btn-cover" aria-hidden="true"></span>
          <span class="error-page__btn-label">Do strony głównej</span>
          <img src="/arrow.svg" alt="" width="26" height="26" />
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .error-page {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: #1e1e1e;
    color: #ffffff;
  }

  .error-page__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(2.5rem, 6vh, 4.5rem);
    width: min(100%, 56rem);
  }

  .error-page__headline {
    position: relative;
    display: grid;
    place-items: center;
    width: max-content;
    max-width: 100%;
    padding: 1.1rem 1.25rem;
  }

  .error-page__title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(3.4rem, 14vw, 8.5rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 0.92;
    text-transform: uppercase;
    text-align: center;
    animation: error-fade-up 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .error-page__badge {
    --badge-rx: 0deg;
    --badge-ry: 0deg;
    --badge-tx: 0px;
    --badge-ty: 0px;
    --badge-rz: 0deg;

    position: absolute;
    z-index: 2;
    display: block;
    color: #1e1e1e;
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 2.8vw, 0.82rem);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    filter: blur(12px);
    perspective: 600px;
    transform-style: preserve-3d;
    will-change: transform;
    transform:
      translate3d(var(--badge-tx), var(--badge-ty), 0)
      rotateX(var(--badge-rx))
      rotateY(var(--badge-ry))
      rotateZ(var(--badge-rz));
    transition:
      opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.35s,
      filter 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.35s;
  }

  .error-page__badge-flip {
    position: relative;
    display: grid;
    transform-style: preserve-3d;
    animation: error-badge-flip-x 10s ease-in-out infinite;
  }

  .error-page__badge-face {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.34rem 0.65rem;
    background: #ffffff;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .error-page__badge-face--back {
    transform: rotateX(180deg);
  }

  .error-page__badge--poznan {
    top: -0.45em;
    left: -0.2rem;
    --badge-rz: -7deg;
  }

  .error-page__badge--taniec {
    top: auto;
    right: -0.15rem;
    bottom: -0.45em;
    --badge-rz: 7deg;
    transition-delay: 0.5s, 0.5s;
  }

  .error-page__badge--taniec .error-page__badge-flip {
    animation-delay: 1s;
  }

  .error-page__badge.is-ready {
    opacity: 1;
    filter: blur(0);
  }

  .error-page__footer {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: center;
    width: 100%;
    animation: error-fade-up 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
  }

  .error-page__copy {
    margin: 0;
    max-width: 28rem;
    justify-self: center;
    text-align: center;
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 400;
    line-height: 1.45;
    color: rgb(255 255 255 / 0.92);
  }

  .error-page__cta {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    box-sizing: border-box;
    width: 100%;
    max-width: 28rem;
    justify-self: center;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    overflow: hidden;
    background: #ffffff;
    color: #1e1e1e;
    padding: 1.05rem 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-button);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-align: left;
    text-transform: uppercase;
    transition: color 0.35s ease;
  }

  .error-page__btn-cover {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #e7e7e7;
    transform: scaleY(0);
    transform-origin: bottom center;
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.2s ease;
  }

  .error-page__btn-label {
    position: relative;
    min-width: 0;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .error-page__cta img {
    position: relative;
    width: var(--size-arrow);
    height: auto;
    flex-shrink: 0;
    transform-origin: center;
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.2s ease;
  }

  .error-page__cta:active .error-page__btn-cover,
  .error-page__cta:focus-visible .error-page__btn-cover {
    transform: scaleY(1);
  }

  .error-page__cta:active .error-page__btn-label,
  .error-page__cta:focus-visible .error-page__btn-label {
    transform: translateX(4px);
  }

  .error-page__cta:active img,
  .error-page__cta:focus-visible img {
    transform: rotate(45deg);
  }

  .error-page__cta:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .error-page__cta:hover .error-page__btn-cover {
      transform: scaleY(1);
    }

    .error-page__cta:hover .error-page__btn-label {
      transform: translateX(4px);
    }

    .error-page__cta:hover img {
      transform: rotate(45deg);
    }

    .error-page__cta:active:hover .error-page__btn-cover {
      background: #cfcfcf;
    }
  }

  @media (min-width: 768px) {
    .error-page__badge {
      font-size: clamp(0.92rem, 1.35vw, 1.2rem);
    }

    .error-page__badge-face {
      padding: 0.62rem 1.2rem;
    }

    .error-page__badge--poznan {
      top: -0.55em;
      left: -0.5rem;
    }

    .error-page__badge--taniec {
      top: auto;
      right: -0.35rem;
      bottom: -0.55em;
    }

    .error-page__footer {
      grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: end;
    }

    .error-page__copy {
      justify-self: start;
      text-align: left;
      max-width: 22rem;
    }

    .error-page__cta {
      justify-self: stretch;
      max-width: none;
    }
  }

  @keyframes error-fade-up {
    from {
      opacity: 0;
      transform: translateY(0.85rem);
      filter: blur(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @keyframes error-badge-flip-x {
    0%,
    42% {
      transform: rotateX(0deg);
    }
    50%,
    92% {
      transform: rotateX(180deg);
    }
    100% {
      transform: rotateX(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .error-page__title,
    .error-page__footer {
      animation: none;
    }

    .error-page__badge {
      opacity: 1;
      filter: none;
      transition: none;
    }

    .error-page__badge-flip {
      animation: none;
    }

    .error-page__badge-face--back {
      display: none;
    }
  }
</style>

<script>
  const page = document.querySelector<HTMLElement>(".error-page");
  const badges = [
    ...document.querySelectorAll<HTMLElement>(".error-page [data-badge]"),
  ];
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const finePointer = window.matchMedia("(pointer: fine)").matches;

  for (const badge of badges) {
    requestAnimationFrame(() => badge.classList.add("is-ready"));
  }

  if (page && badges.length && !reduceMotion) {
    const MAX_TILT = 18;
    const MAX_PULL = 14;
    const RANGE = 320;
    const EASE = 0.14;

    type Tilt = { rx: number; ry: number; tx: number; ty: number };

    const state = badges.map((el) => ({
      el,
      current: { rx: 0, ry: 0, tx: 0, ty: 0 } as Tilt,
      target: { rx: 0, ry: 0, tx: 0, ty: 0 } as Tilt,
    }));

    let frame = 0;
    let active = false;

    const apply = (el: HTMLElement, tilt: Tilt) => {
      el.style.setProperty("--badge-rx", `${tilt.rx.toFixed(2)}deg`);
      el.style.setProperty("--badge-ry", `${tilt.ry.toFixed(2)}deg`);
      el.style.setProperty("--badge-tx", `${tilt.tx.toFixed(2)}px`);
      el.style.setProperty("--badge-ty", `${tilt.ty.toFixed(2)}px`);
    };

    const render = () => {
      frame = 0;
      let moving = false;

      for (const item of state) {
        item.current.rx += (item.target.rx - item.current.rx) * EASE;
        item.current.ry += (item.target.ry - item.current.ry) * EASE;
        item.current.tx += (item.target.tx - item.current.tx) * EASE;
        item.current.ty += (item.target.ty - item.current.ty) * EASE;
        apply(item.el, item.current);

        if (
          Math.abs(item.target.rx - item.current.rx) > 0.05 ||
          Math.abs(item.target.ry - item.current.ry) > 0.05 ||
          Math.abs(item.target.tx - item.current.tx) > 0.05 ||
          Math.abs(item.target.ty - item.current.ty) > 0.05
        ) {
          moving = true;
        }
      }

      if (moving || active) {
        frame = window.requestAnimationFrame(render);
      }
    };

    const requestRender = () => {
      if (!frame) frame = window.requestAnimationFrame(render);
    };

    if (finePointer) {
      const setTargetsFromPoint = (x: number, y: number) => {
        for (const item of state) {
          const rect = item.el.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          const nx = Math.max(-1, Math.min(1, (x - cx) / RANGE));
          const ny = Math.max(-1, Math.min(1, (y - cy) / RANGE));

          item.target.rx = -ny * MAX_TILT;
          item.target.ry = nx * MAX_TILT;
          item.target.tx = nx * MAX_PULL;
          item.target.ty = ny * MAX_PULL;
        }
      };

      page.addEventListener(
        "pointermove",
        (event) => {
          if (event.pointerType === "touch") return;
          active = true;
          setTargetsFromPoint(event.clientX, event.clientY);
          requestRender();
        },
        { passive: true },
      );

      page.addEventListener(
        "pointerleave",
        () => {
          active = false;
          for (const item of state) {
            item.target.rx = 0;
            item.target.ry = 0;
            item.target.tx = 0;
            item.target.ty = 0;
          }
          requestRender();
        },
        { passive: true },
      );
    }
  }
</script>
