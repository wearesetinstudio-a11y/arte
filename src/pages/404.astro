---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Strona nie znaleziona | Arte de Baile"
  description="Ta strona nie istnieje lub zmieniła lokalizację. Wróć do strony głównej Arte de Baile."
  preloader={false}
  robots="noindex, nofollow"
>
  <main class="error-page">
    <div class="error-page__inner">
      <div class="error-page__headline">
        <h1 class="error-page__title">UPSSS...</h1>
        <span class="error-page__badge error-page__badge--poznan">#Poznań</span>
        <span class="error-page__badge error-page__badge--taniec">#Taniec</span>
      </div>

      <div class="error-page__footer">
        <p class="error-page__copy">
          Ta strona nie istnieje lub zmieniła lokalizację. Wróć do strony
          głównej lub skontaktuj się z nami bezpośrednio, aby trafić we właściwe
          miejsce.
        </p>

        <a href="/" class="error-page__cta">
          <span class="error-page__btn-cover" aria-hidden="true"></span>
          <span class="error-page__btn-label">Do strony głównej</span>
          <img src="/arrow.svg" alt="" width="26" height="26" />
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .error-page {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: #1e1e1e;
    color: #ffffff;
  }

  .error-page__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(2.5rem, 6vh, 4.5rem);
    width: min(100%, 56rem);
  }

  .error-page__headline {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
  }

  .error-page__title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(3.4rem, 14vw, 8.5rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 0.92;
    text-transform: uppercase;
    text-align: center;
    animation: error-fade-up 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .error-page__badge {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 1.05rem;
    background: #ffffff;
    color: #1e1e1e;
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 1.2vw, 1rem);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    animation: error-badge-in 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .error-page__badge--poznan {
    top: -0.35em;
    left: 4%;
    transform: rotate(-8deg);
    animation-delay: 0.18s;
  }

  .error-page__badge--taniec {
    right: 8%;
    bottom: -0.15em;
    transform: rotate(7deg);
    animation-delay: 0.32s;
  }

  .error-page__footer {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: center;
    width: 100%;
    animation: error-fade-up 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
  }

  .error-page__copy {
    margin: 0;
    max-width: 28rem;
    justify-self: center;
    text-align: center;
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 400;
    line-height: 1.45;
    color: rgb(255 255 255 / 0.92);
  }

  .error-page__cta {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    box-sizing: border-box;
    width: 100%;
    max-width: 28rem;
    justify-self: center;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    overflow: hidden;
    background: #ffffff;
    color: #1e1e1e;
    padding: 1.05rem 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-button);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-align: left;
    text-transform: uppercase;
    transition: color 0.35s ease;
  }

  .error-page__btn-cover {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #e7e7e7;
    transform: scaleY(0);
    transform-origin: bottom center;
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.2s ease;
  }

  .error-page__btn-label {
    position: relative;
    min-width: 0;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .error-page__cta img {
    position: relative;
    width: var(--size-arrow);
    height: auto;
    flex-shrink: 0;
    transform-origin: center;
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.2s ease;
  }

  .error-page__cta:active .error-page__btn-cover,
  .error-page__cta:focus-visible .error-page__btn-cover {
    transform: scaleY(1);
  }

  .error-page__cta:active .error-page__btn-label,
  .error-page__cta:focus-visible .error-page__btn-label {
    transform: translateX(4px);
  }

  .error-page__cta:active img,
  .error-page__cta:focus-visible img {
    transform: rotate(45deg);
  }

  .error-page__cta:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .error-page__cta:hover .error-page__btn-cover {
      transform: scaleY(1);
    }

    .error-page__cta:hover .error-page__btn-label {
      transform: translateX(4px);
    }

    .error-page__cta:hover img {
      transform: rotate(45deg);
    }

    .error-page__cta:active:hover .error-page__btn-cover {
      background: #cfcfcf;
    }
  }

  @media (min-width: 768px) {
    .error-page__badge--poznan {
      left: 8%;
      top: -0.2em;
    }

    .error-page__badge--taniec {
      right: 14%;
      bottom: 0.05em;
    }

    .error-page__footer {
      grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: end;
    }

    .error-page__copy {
      justify-self: start;
      text-align: left;
      max-width: 22rem;
    }

    .error-page__cta {
      justify-self: stretch;
      max-width: none;
    }
  }

  @keyframes error-fade-up {
    from {
      opacity: 0;
      transform: translateY(0.85rem);
      filter: blur(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @keyframes error-badge-in {
    from {
      opacity: 0;
      filter: blur(10px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .error-page__title,
    .error-page__badge,
    .error-page__footer {
      animation: none;
    }
  }
</style>
