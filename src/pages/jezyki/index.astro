---
import Layout from "../../layouts/Layout.astro";
import LanguagesOffer from "../../components/LanguagesOffer.astro";
import Contact from "../../components/Contact.astro";
---

<Layout
  title="Sztuka Komunikacji — Arte"
  description="Angielski i hiszpański z Viktoria Oskaldowicz. Arte — sztuka komunikacji."
>
  <main>
    <header class="border-b border-stone/60 px-6 py-6">
      <a
        href="/"
        class="inline-flex items-center gap-2 font-sans text-sm text-fog transition-opacity hover:opacity-70"
      >
        <span aria-hidden="true">←</span>
        Arte
      </a>
    </header>
    <LanguagesOffer />
    <Contact />
  </main>
</Layout>
